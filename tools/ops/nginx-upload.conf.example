# Example only; place zones in http {}, then adapt the server/location to your TLS setup.
# Do not deploy blindly: choose limits for school NATs and keep the API bound to loopback.
limit_req_zone $binary_remote_addr zone=homework_upload_rate:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=homework_upload_connections:10m;

server {
    listen 80;
    server_name homework.example.com;
    client_max_body_size 50m;
    client_body_timeout 30s;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location ~ ^/api/(upload-sessions/|assignments/[^/]+/(upload-sessions|submissions)|assignments/import|students/import) {
        limit_req zone=homework_upload_rate burst=20 nodelay;
        limit_req_status 429;
        limit_conn homework_upload_connections 20;
        limit_conn_status 429;
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_read_timeout 90s;
        proxy_send_timeout 60s;
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
